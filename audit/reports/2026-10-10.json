      "id": "IDENTITY-NAME-COLLISION",
      "classification": "verified contract mismatch",
      "finding": "LAPLACE_PGUSER names an OS service account in Operations and a database login in monorepo Windows configuration.",
      "evidence": [
        {
          "repository": "Laplace-Operations",
          "revision": "9382f00aa1fd900274fbfae816195d7dd777cb2a",
          "file": "laplace.env.ps1",
          "line": 36,
          "snippet": "Set-Default LAPLACE_PGUSER  'NT AUTHORITY\\NetworkService'                   # the account the service runs as (S-1-5-20): owns the data and the logs, reads the install",
          "url": "https://github.com/SaltyPatron/Laplace-Operations/blob/9382f00aa1fd900274fbfae816195d7dd777cb2a/laplace.env.ps1#L36"
        },
        {
          "repository": "Laplace",
          "revision": "58cab06ee7b460949cb2164cb29b7e24df50c8a5",
          "file": "scripts/win/env.cmd",
          "line": 72,
          "snippet": "rem LAPLACE_PGHOST/LAPLACE_PGUSER feed BOTH the CLI connection string below AND",
          "url": "https://github.com/SaltyPatron/Laplace/blob/58cab06ee7b460949cb2164cb29b7e24df50c8a5/scripts/win/env.cmd#L72"
        },
        {
          "repository": "Laplace",
          "revision": "58cab06ee7b460949cb2164cb29b7e24df50c8a5",
          "file": "scripts/win/env.cmd",
