{
  "schema": "laplace.modular-installation/v1",
  "host": "hart-server",
  "operator": "ahart",
  "deployment_group": "laplace-runner",
  "runtime_user": "laplace-modular",
  "runtime_group": "laplace-modular",
  "role": "laplace_modular_runtime",
  "database": "laplace",
  "socket": "/tmp",
  "port": 5432,
  "pgbin": "/usr/local/pgsql/bin",
  "pg_os_user": "postgres",
  "pgdata": "/data/pgdata",
  "postgres_service": "pgdata.service",
  "source": "/repos/src",
  "build": "/repos/build/modular-runtime",
  "prefix": "/hosting/laplace/modular",
  "state": "/hosting/laplace/runtime/modular",
  "installed_config": "/etc/laplace/modular.json",
  "environment_file": "/etc/laplace/modular.env",
  "lock": "/run/lock/laplace/host-resource.lock",
  "restart_signal": "/run/lock/laplace/restart-modular-mcp",
  "receipts": "/repos/work/logs/modular",
  "bind": "127.0.0.1",
  "http_port": 5188,
  "web_port": 5193,
  "web_path": "/modular",
  "web_origin": "https://staging.hartonomous.com",
  "tier0": "/repos/work/tier0/tier0.bin",
  "flags": "/repos/work/tier0/tier0.flags",
  "highway": "/repos/work/tier0/tier0.highway",
  "grammars": "/repos/build/grammars",
  "ucd": "/vault/Data/UCD",
  "threads": 2,
  "build_jobs": 6,
  "batch_mb": 64,
  "connection_limit": 8,
  "legacy_user": "ahart",
  "legacy_unit": "laplace-mcp.service",
  "operator_client": {
    "role": "laplace",
    "work": "/repos/work/clients/ahart/laplace",
    "data": "/vault/Data",
    "source": "/repos/src",
    "models": "/vault/models",
    "command": "/home/ahart/.local/bin/laplace",
    "configuration": "/home/ahart/.config/laplace/client.json"
  }
}
