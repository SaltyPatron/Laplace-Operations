    {"src":["hart-server","hart-server-v6","hart-prod","hart-prod-v6","hart-cloud","hart-cloud-v6"],"dst":["hart-desktop","hart-desktop-v6","hart-desktop-lan"],"ip":["tcp:443"]},
    // Private DNS via the advertised LAN route, including TCP and DNS-over-TLS.
