    {"src":["hart-prod","hart-prod-v6","hart-cloud","hart-cloud-v6"],"dst":["hart-server","hart-server-v6","hart-server-lan"],"ip":["tcp:22","tcp:443","tcp:5432","tcp:8080"]},
