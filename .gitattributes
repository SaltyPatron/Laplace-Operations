# LF in every checkout, Windows included: sh, awk and git apply read these, and a carriage return becomes part of a
# flag, a path or a patch line.
*.sh            text eol=lf
*.py            text eol=lf
*.tsv           text eol=lf
*.env           text eol=lf
*.patch         text eol=lf
toolchain/windows/icx-pgxs  text eol=lf
