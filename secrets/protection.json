{
  "host": "hart-server",
  "hostname": "openbao.hartonomous.com",
  "address": "192.168.1.2",
  "service": "openbao",
  "site": "/etc/nginx/sites-available/secrets-lan",
  "http_configuration": "/etc/nginx/conf.d/laplace-openbao-limits.conf",
  "server_configuration": "/etc/nginx/snippets/laplace-openbao-limits.conf",
  "client_rate": 10,
  "client_burst": 30,
  "renewal_rate": 1,
  "renewal_burst": 10,
  "total_rate": 40,
  "total_burst": 80,
  "audit_log": "/var/log/openbao/audit.log",
  "audit_rotation": "/etc/logrotate.d/openbao",
  "audit_rotate_mib": 64,
  "audit_rotate_count": 16,
  "nginx_rotation": "/etc/logrotate.d/nginx",
  "nginx_rotate_mib": 32,
  "overflow_archive_directory": "/hosting/openbao/audit-archive",
  "overflow_threshold_mib": 1024,
  "receipt_directory": "/repos/work/logs/secrets-protection"
}
