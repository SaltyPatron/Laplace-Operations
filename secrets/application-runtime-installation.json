{
  "production": {
    "host": "hart-prod",
    "record": "application-runtime",
    "database_host": "127.0.0.1",
    "database": "laplace-app",
    "role": "laplace_app_runtime",
    "database_owner": "laplace",
    "port": 5432,
    "pool_max": 2,
    "connection_limit": 6,
    "pgbin": "/usr/lib/postgresql/18/bin",
    "pgsocket": "/var/run/postgresql",
    "pg_os_user": "postgres",
    "runtime_user": "laplace-api",
    "state": "/var/lib/laplace-api",
    "prefix": "/opt/laplace",
    "machine_file": "/etc/laplace/machine.env",
    "host_lock": "/run/lock/laplace/host-resource.lock",
    "credentials": "/etc/laplace/runtime-approle.json",
    "bao_role": "laplace-hart-prod-runtime",
    "bao_address": "https://openbao.hartonomous.com",
    "public_base": "https://api.hartonomous.com",
    "work": "/repos/work/application-runtime"
  }
}
