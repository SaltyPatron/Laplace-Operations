# Laplace's environment: the one definition of where everything is. Source it before building or running anything.
# Every Laplace build (Laplace-Native, Laplace-postgres, Laplace-Engine) and the laplace program read these; what is
# not set here falls back to the same defaults, compiled in.
#
#   source /repos/src/Laplace-Operations/laplace.env
#
# Another machine declares what differs from hart-server in /etc/laplace/machine.env (its network, its volumes, its
# repositories and agent labels), read first so every tool, unit and runner on it sees the same declaration without
# anyone's shell environment; a value set in the environment still wins.
# Bash supplies the sourced file; the POSIX entry points live beside this file.
_lp_env_directory=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE:-$0}")" && pwd)
if ! _lp_machine_values=$(python3 "$_lp_env_directory/machine-env.py"); then
  unset _lp_env_directory _lp_machine_values
  return 1 2>/dev/null || exit 1
fi
eval "$_lp_machine_values"
unset _lp_env_directory _lp_machine_values

export LAPLACE_SRC=${LAPLACE_SRC:-/repos/src}                  # Laplace's repositories and its dependencies' sources
export LAPLACE_BUILD=${LAPLACE_BUILD:-/repos/build}            # build trees
export LAPLACE_WORK=${LAPLACE_WORK:-/repos/work}               # generated data and logs
export LAPLACE_DEPSRC=${LAPLACE_DEPSRC:-$LAPLACE_SRC}          # the dependencies' sources (blake3, core-math, tree-sitter, postgresql, ...): beside Laplace's, or elsewhere for an agent
export LAPLACE_DEPS=${LAPLACE_DEPS:-/repos/deps}               # installed dependencies
export LAPLACE_DATA=${LAPLACE_DATA:-/vault/Data}               # corpora and the Unicode data
export LAPLACE_MODELS=${LAPLACE_MODELS:-/vault/models}         # model files the recipes read (Laplace-Engine recipes/tokenizers: */tokenizer.json)

# The machine, as setup.sh declares it (Operations: Setup, Database). Every name here is this installation's choice.
export LAPLACE_PREFIX=${LAPLACE_PREFIX:-/usr/local}            # where the dependencies built from source install
export LAPLACE_PG_DIR=${LAPLACE_PG_DIR:-/usr/local/pgsql}      # PostgreSQL 18, built with icx
export LAPLACE_PGDATA=${LAPLACE_PGDATA:-/data/pgdata}          # the cluster: heap and indexes
export LAPLACE_PGWAL=${LAPLACE_PGWAL:-$LAPLACE_PGDATA/pg_wal}  # its write-ahead log, on its own volume
export LAPLACE_PGTEMP=${LAPLACE_PGTEMP:-/data/pgtemp}          # its temporary files, a tablespace on its own volume
export LAPLACE_PGUSER=${LAPLACE_PGUSER:-postgres}              # the operating-system user the server runs as
export LAPLACE_PGSERVICE=${LAPLACE_PGSERVICE:-pgdata}          # the systemd unit
export LAPLACE_ROLE=${LAPLACE_ROLE:-laplace}                   # the database role Laplace connects as
export LAPLACE_LAN=${LAPLACE_LAN:-192.168.1.0/24}              # the network the server is reachable from
export LAPLACE_PGPORT=${LAPLACE_PGPORT:-5432}                  # the port the server listens on
export LAPLACE_SOURCES=${LAPLACE_SOURCES:-}                      # the sources a deployment ingests, by name, in this order; empty: every source in recipes/order
# The deployment target's checks (verify.sh) and its reseed policy (seed-stamp.sh): the sources whose claims are
# decomposed twice to prove a decomposition gives the same claim set every run, and whether a deployment drops and
# reseeds the database when what it was seeded with changed (auto), or never does so by itself (never).
export LAPLACE_DETERMINISM=${LAPLACE_DETERMINISM:-"iso-639 open-english-wordnet"}
export LAPLACE_RESEED=${LAPLACE_RESEED:-auto}
export LAPLACE_LOCKS=${LAPLACE_LOCKS:-/run/lock/laplace}       # one deployment per database at a time: the locks, the shared group's, made at boot
export LAPLACE_VOLUMES=${LAPLACE_VOLUMES:-"
vg-data    lv-postgres  740G  xfs  $LAPLACE_PGDATA   heap and indexes: the fastest drive
vg-wal     lv-wal        64G  xfs  $LAPLACE_PGWAL    write-ahead log: its own SSD
vg-wal     lv-pgtemp     64G  xfs  $LAPLACE_PGTEMP   temporary files: its own SSD
vg-repo    lv-repo      128G  xfs  /repos            sources, builds, work: an SSD
vg-vault   lv-vault      ALL  xfs  /vault            data sets and archives: bulk
"}                                                            # vg lv size fs mount: what Laplace keeps apart; an existing volume is never resized or reformatted
# A machine without those volume groups skips their lines. A machine with one disk (a cloud host) declares what it
# keeps apart as files: the group `file` makes a file of that size under /var/lib/laplace/volumes, formatted and
# mounted through a loop device, e.g. LAPLACE_VOLUMES="file lv-wal 16G xfs $LAPLACE_PGWAL" (hart-cloud).
# The agents (agents.sh): one GitHub Actions runner per repository on this machine, all as one user of their own,
# separate from anyone's development environment. Checkouts/work use $LAPLACE_WORK/agents/<repo>;
# builds use $LAPLACE_BUILD/agents/<repo>. Runner programs live under LAPLACE_AGENT_HOME.
# The database, dependencies and data are the machine's. No runner has root:
# setup.sh and agents.sh are run by a person (setup.sh rights removes any rule that gave a runner more).
export LAPLACE_GITHUB=${LAPLACE_GITHUB:-SaltyPatron}           # the account or organisation the repositories are under
export LAPLACE_REPOS=${LAPLACE_REPOS:-"Laplace-Native Laplace-postgres Laplace-Engine Laplace-Wiki Laplace-Operations Laplace Laplace-MCP Laplace-Refactor Laplace-Conventional"}   # every repository with a self-hosted workflow (agents.sh status checks the list against GitHub); Laplace-Prototype has none
# a repository's own runner labels, beyond LAPLACE_AGENT_LABELS and its name: the labels its workflows' runs-on ask for
export LAPLACE_AGENT_LABELS_Laplace_Refactor=${LAPLACE_AGENT_LABELS_Laplace_Refactor:-laplace-refactor}
export LAPLACE_AGENT_LABELS_Laplace_Conventional=${LAPLACE_AGENT_LABELS_Laplace_Conventional:-laplace-conventional}   # GPU scheduling requires an explicit usable-host declaration; hart-server's damaged 1080 Ti is off limits
# A host may probe/use CUDA only when explicitly named. Empty on CPU-only hosts.
export LAPLACE_GPU_HOST=${LAPLACE_GPU_HOST:-}
export LAPLACE_AGENT_USER=${LAPLACE_AGENT_USER:-laplace-runner}
export LAPLACE_AGENT_HOME=${LAPLACE_AGENT_HOME:-/var/lib/agents/laplace-runner}
export LAPLACE_AGENT_LABELS=${LAPLACE_AGENT_LABELS:-laplace}    # every runner carries these, and its repository's name
export LAPLACE_GROUP=${LAPLACE_GROUP:-laplace-runner}         # the group the operator and the agent share: every shared tree is its, group-writable
export LAPLACE_PG_GROUP=${LAPLACE_PG_GROUP:-postgres-extensions}   # the group that may install extensions into $LAPLACE_PG_DIR

# The machine's shares for the development machine (setup.sh shares; not part of all): plain SMB 3 shares of the disks
# that already exist, for one user, from the LAN only (LAPLACE_LAN, its IPv6 prefix, and link-local on the interface,
# which is what Windows' name lookup on the LAN can return). name  path  what
export LAPLACE_SHARE_USER=${LAPLACE_SHARE_USER:-ahart}
export LAPLACE_SHARE_LAN6=${LAPLACE_SHARE_LAN6:-fde2:42c2:50b0::/64}   # the router's DNS gives the machine an IPv6 address too, and Windows prefers it
export LAPLACE_SHARE_IF=${LAPLACE_SHARE_IF:-eno1}
export LAPLACE_SHARES=${LAPLACE_SHARES:-"
vault    /vault        the main store: organized data, by modality and format
archive  /archive      archives
backup   /backup       cold storage
inbox    /vault/Inbox  the dump spot: sorted into vault later
"}

export LAPLACE_NATIVE=${LAPLACE_NATIVE:-$LAPLACE_SRC/Laplace-Native}
export LAPLACE_RECIPES=${LAPLACE_RECIPES:-$LAPLACE_SRC/Laplace-Engine/recipes}
export LAPLACE_FIRMWARE=${LAPLACE_FIRMWARE:-$LAPLACE_SRC/Laplace-Engine/firmware/program.firmware}   # the firmware a pull runs under: one for each human being
export LAPLACE_TIER0=${LAPLACE_TIER0:-$LAPLACE_WORK/tier0/tier0.bin}   # laplace tier0 writes it; every install with its fingerprint agrees
export LAPLACE_HIGHWAY=${LAPLACE_HIGHWAY:-${LAPLACE_TIER0%.bin}.highway}   # laplace highway writes it: the types the resources list, and the mappings between them
export LAPLACE_GRAMMARS=${LAPLACE_GRAMMARS:-$LAPLACE_BUILD/grammars}   # tools/build_grammars.sh writes them
export LAPLACE_UCD=${LAPLACE_UCD:-$LAPLACE_DATA/UCD}
export LAPLACE_ICU_DIR=${LAPLACE_ICU_DIR:-$LAPLACE_DEPS/icu78}   # ICU 78: Unicode 17, the version tier 0 is built from
export LAPLACE_BLAKE3_DIR=${LAPLACE_BLAKE3_DIR:-$LAPLACE_DEPSRC/blake3/c} LAPLACE_COREMATH=${LAPLACE_COREMATH:-$LAPLACE_DEPSRC/core-math} LAPLACE_TREESITTER=${LAPLACE_TREESITTER:-$LAPLACE_DEPSRC/tree-sitter}
export LAPLACE_GRAMMAR_SRC=${LAPLACE_GRAMMAR_SRC:-$LAPLACE_DATA/TreeSitter}   # the grammars' sources; tools/build_grammars.sh compiles them into $LAPLACE_GRAMMARS
export LAPLACE_CONNINFO="${LAPLACE_CONNINFO:-host=/tmp port=$LAPLACE_PGPORT user=$LAPLACE_ROLE dbname=laplace}"    # libpq form; names the database

# Every core. nproc reports OMP_NUM_THREADS when that variable is already set, so a shell
# that capped it would be copied back into itself and, from setup.sh, into the server's
# worker counts. Count the processors with the variable out of the way, then set it.
_lp_cores=$(env -u OMP_NUM_THREADS -u MKL_NUM_THREADS nproc)
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-$_lp_cores} MKL_NUM_THREADS=${MKL_NUM_THREADS:-$_lp_cores}
unset _lp_cores

# The toolchain: Intel oneAPI (icx, MKL), and the PostgreSQL the extension is built for.
# setvars.sh reads variables that may be unset and is not to be run twice: sourced once, without -u, quietly.
if [ -z "${SETVARS_COMPLETED:-}" ] && [ -r /opt/intel/oneapi/setvars.sh ]; then
  case $- in *u*) _lp_u=1 ;; *) _lp_u=0 ;; esac; set +u
  . /opt/intel/oneapi/setvars.sh >/dev/null 2>&1 || true
  [ "$_lp_u" = 1 ] && set -u; unset _lp_u
fi
export PG_CONFIG=$LAPLACE_PG_DIR/bin/pg_config
export PATH=$LAPLACE_BUILD/Laplace-Engine/icx-release:$LAPLACE_PG_DIR/bin:${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}/.local/bin:$PATH   # HOME is unset under systemd-run and some sudo policies

# Where other hosts' backups land (setup.sh landing; part of all on the host that has the volume). The host that runs the part takes them at LAPLACE_LANDING, a
# directory on a volume of its own, takes them from the hosts backup/landing.keys names: as LAPLACE_LANDING_USER, by
# key, write-only, each host under its own directory. Retention is the landing host's: what is older than
# LAPLACE_LANDING_KEEP days goes, and a host's newest LAPLACE_LANDING_MIN files stay whatever their age.
export LAPLACE_LANDING=${LAPLACE_LANDING:-/backup/laplace}   # hart-server's backup array; a host that is not a landing host does not run the part
export LAPLACE_LANDING_USER=${LAPLACE_LANDING_USER:-laplace-backup}
export LAPLACE_LANDING_KEEP=${LAPLACE_LANDING_KEEP:-30}
export LAPLACE_LANDING_MIN=${LAPLACE_LANDING_MIN:-7}
