+#ifdef _WIN32
+/* The Universal CRT has no asprintf/vasprintf, and spells getpid _getpid */
+#include <process.h>
+#define getpid _getpid
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+static inline int
+vasprintf(char **out, const char *format, va_list ap)
+{
+	va_list count;
+	int n;
+	va_copy(count, ap);
+	n = _vscprintf(format, count);
+	va_end(count);
+	if (n < 0 || !(*out = malloc((size_t)n + 1)))
+		return -1;
+	return vsnprintf(*out, (size_t)n + 1, format, ap);
+}
+static inline int
+asprintf(char **out, const char *format, ...)
+{
+	va_list ap;
+	int n;
+	va_start(ap, format);
+	n = vasprintf(out, format, ap);
+	va_end(ap);
+	return n;
+}
+#endif
 
 
